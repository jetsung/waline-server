# ============================================================
# Waline Rust 配置文件示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# -----------------------------------------------------------
# 数据库配置（PostgreSQL,MySQL,SQLite）
# -----------------------------------------------------------

DATABASE_URL="sqlite://./waline.sqlite?mode=rwc"

# -----------------------------------------------------------
# 安全与认证
# -----------------------------------------------------------

# JWT 签名密钥（生产环境务必设置，否则使用数据库密码或为空）
JWT_TOKEN=change-me-to-a-random-string

# 安全域名，逗号分隔
# SECURE_DOMAINS=example.com,www.example.com

# 登录模式：设为 force 则强制登录后才能评论
# LOGIN=force

# 评论审核，新评论需管理员审批后才显示
# COMMENT_AUDIT=true

# 违禁词，逗号分隔
# FORBIDDEN_WORDS=违禁词1,违禁词2

# 单 IP 每秒请求限制
# IPQPS=60

# Akismet 反垃圾 API Key
# AKISMET_KEY=

# Google reCAPTCHA v3 密钥
# RECAPTCHA_V3_SECRET=
# RECAPTCHA_V3_KEY=

# Cloudflare Turnstile 密钥
# TURNSTILE_SECRET=
# TURNSTILE_KEY=

# 禁止记录用户 User-Agent
# DISABLE_USERAGENT=true

# 禁止记录 IP 归属地
# DISABLE_REGION=true

# IP 黑名单，逗号分隔
# DISALLOW_IP_LIST=

# -----------------------------------------------------------
# 站点信息
# -----------------------------------------------------------

# SITE_NAME=My Site
# SITE_URL=https://example.com
# SERVER_URL=https://waline.example.com

# -----------------------------------------------------------
# SMTP 邮件
# -----------------------------------------------------------

# 邮件服务商预设（设置后无需填 SMTP_HOST/PORT）：gmail / outlook / qq / 163 / 126 / aliyun
# SMTP_SERVICE=qq

# 自定义 SMTP（与 SMTP_SERVICE 二选一）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true

# SMTP_USER=your@email.com
# SMTP_PASS=your-password

# 发件人信息
# SENDER_EMAIL=your@email.com
# SENDER_NAME=Blog Notify

# 博主邮箱，匹配此邮箱的评论标记为博主
# AUTHOR_EMAIL=admin@example.com

# 禁止通知博主
# DISABLE_AUTHOR_NOTIFY=false

# -----------------------------------------------------------
# 邮件模板（支持变量：{{site.name}} {{site.url}} {{comment.nick}} {{comment.content}} 等）
# -----------------------------------------------------------

# MAIL_SUBJECT=
# MAIL_TEMPLATE=
# MAIL_SUBJECT_ADMIN=
# MAIL_TEMPLATE_ADMIN=

# -----------------------------------------------------------
# 通知渠道
# -----------------------------------------------------------

# Server酱
# SC_KEY=

# 企业微信（格式：企业ID,应用Secret,接收用户,应用AgentId,缩略图MediaId）
# QYWX_AM=corp_id,app_secret,touser,agent_id,thumb_media_id

# Qmsg 酱
# QMSG_KEY=
# QQ_ID=

# Telegram
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# PushPlus
# PUSH_PLUS_KEY=
# PUSH_PLUS_TOPIC=
# PUSH_PLUS_CHANNEL=
# PUSH_PLUS_WEBHOOK=

# Discord
# DISCORD_WEBHOOK=

# 飞书/Lark
# LARK_WEBHOOK=
# LARK_SECRET=

# -----------------------------------------------------------
# 通知模板
# -----------------------------------------------------------

# QQ_TEMPLATE=
# TG_TEMPLATE=
# WX_TEMPLATE=
# SC_TEMPLATE=
# DISCORD_TEMPLATE=
# LARK_TEMPLATE=

# -----------------------------------------------------------
# 头像
# -----------------------------------------------------------

# Gravatar 代理地址，设为 false 禁用代理
# AVATAR_PROXY=https://cravatar.cn/avatar/

# Gravatar 默认头像策略
# GRAVATAR_STR=mp

# -----------------------------------------------------------
# Markdown 渲染
# -----------------------------------------------------------

# 渲染配置 JSON
# MARKDOWN_CONFIG={}

# 代码高亮（设为 false 禁用）
# MARKDOWN_HIGHLIGHT=true

# Emoji 短代码（设为 false 禁用）
# MARKDOWN_EMOJI=true

# 下标 ~text~（设为 false 禁用）
# MARKDOWN_SUB=true

# 上标 ^text^（设为 false 禁用）
# MARKDOWN_SUP=true

# 数学公式引擎：mathjax / katex / false
# MARKDOWN_TEX=mathjax

# MathJax 配置 JSON
# MARKDOWN_MATHJAX={}

# KaTeX 配置 JSON
# MARKDOWN_KATEX={}

# -----------------------------------------------------------
# OAuth
# -----------------------------------------------------------

# OAuth 外部服务地址
# OAUTH_URL=https://oauth.lithub.cc

# -----------------------------------------------------------
# 其他
# -----------------------------------------------------------

# 用户等级阈值，逗号分隔
# LEVELS=0,10,20,50,100,200,500,1000

# 单次点赞最大增量
# LIKE_INC_MAX=1

# Webhook URL，有新评论时 POST 通知
# WEBHOOK=

# IP 归属地数据库路径
# IP2REGION_DB=
# IP2REGION_DB_V4=
# IP2REGION_DB_V6=

# 管理后台 JS 资源地址
# WALINE_ADMIN_MODULE_ASSET_URL=//unpkg.com/@waline/admin

# 是否开启调试模式
DEBUG=false
